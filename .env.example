# Server Configuration
PORT=3000

# Optional: Google Maps Platform API Key (Geocoding API, Places API New)
# If omitted, GatherMap seamlessly uses built-in landmark geocoder & OpenStreetMap Nominatim
GOOGLE_MAPS_API_KEY=

# Optional: Google Gemini API Key for dynamic group preference & dietary intent parsing
# If omitted, GatherMap runs on its deterministic, zero-dependency semantic rule engine
GEMINI_API_KEY=

# Optional: Supabase PostgreSQL Cloud Database (Production)
# If omitted, GatherMap runs on persistent local SQLite engine (gathermap.db)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
